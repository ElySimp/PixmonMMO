{
  "name": "pixmonmmo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "backend": "node backend/server.js",
    "dev": "node scripts/start-clean.js",
    "dev-verbose": "concurrently --kill-others --names \"BACKEND,FRONTEND\" --prefix-colors \"magenta,cyan\" --raw \"npm run backend\" \"npm run frontend\"",
    "dev-dashboard": "node scripts/dev-dashboard.js",
    "dev-enhanced": "node scripts/enhanced-terminal.js",
    "dev-terminal": "node scripts/dev-terminal.js",
    "dev-terminal-v2": "node scripts/dev-terminal-v2.js",
    "integrate-player-tracker": "node scripts/integrate-player-tracker.js",
    "dev:advanced": "node scripts/integrate-player-tracker.js && node scripts/dev-terminal-v2.js",
    "build": "cd frontend && npm run build",
    "vercel-build": "cd frontend && npm install && npm run build",
    "lint": "cd frontend && npm run lint",
    "preview": "cd frontend && npm run preview",
    "start": "node backend/server.js",
    "seed": "node scripts/seed-mongodb.js",
    "verify:m1": "node scripts/verify-m1.js",
    "test": "vitest run",
    "test:smoke": "vitest run tests/helpers/smoke.test.js",
    "test:e2e": "vitest run tests/e2e",
    "test:tier1": "vitest run tests/e2e/tier1-features",
    "test:tier2": "vitest run tests/e2e/tier2-boundaries",
    "test:tier3": "vitest run tests/e2e/tier3-pairwise",
    "test:tier4": "vitest run tests/e2e/tier4-scenarios",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.48",
    "multer": "^2.0.0",
    "mongoose": "^8.10.0",
    "node-cron": "^4.1.0",
    "node-fetch": "^2.7.0",
    "react-toastify": "^11.0.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "better-logging": "^5.0.0",
    "chalk": "^4.1.2",
    "concurrently": "^9.1.2",
    "pm2": "^6.0.8",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
